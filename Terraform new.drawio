        <mxCell id="IidzGLquWnex7k45harK-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;h1 style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;IaC (Infrastructure as Code)&lt;/font&gt;&lt;/h1&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;What is IaC?&lt;/font&gt;&lt;/h2&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;IaC (Infrastructure as Code) means managing and creating infrastructure using code instead of doing everything manually.&lt;/font&gt;&lt;/p&gt;&lt;h3&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Simple Explanation&lt;/font&gt;&lt;/h3&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Earlier:&lt;/font&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Servers were created manually&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Networks were configured manually&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Now with IaC:&lt;/font&gt;&lt;/p&gt;&lt;ol&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Write the code once&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Infrastructure is created automatically&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;h2&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Benefits of IaC&lt;/font&gt;&lt;/h2&gt;&lt;ol&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Automation – reduces manual work&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Fast deployment&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Same setup can be created again easily&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;li&gt;&lt;p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Fewer errors and mistakes&lt;/font&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ol&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="720" width="650" x="2400" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="IidzGLquWnex7k45harK-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;align=left;" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;Terraform is an IaC tool that can create resources on multiple clouds&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Simple -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Terraform ek IaC tool h&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;jo &lt;strong data-start=&quot;251&quot; data-end=&quot;298&quot;&gt;different cloud platforms (AWS, Azure, GCP)&lt;/strong&gt; par&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-start=&quot;213&quot; data-end=&quot;364&quot;&gt;&lt;strong data-start=&quot;305&quot; data-end=&quot;364&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;resources create kar sakta hai — wo bhi code ke through&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p data-start=&quot;213&quot; data-end=&quot;364&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span data-start=&quot;305&quot; data-end=&quot;364&quot;&gt;1&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;391&quot; data-end=&quot;404&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Terraform&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;- tool h&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;213&quot; data-end=&quot;364&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;420&quot; data-end=&quot;452&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;IaC (Infrastructure as Code) -&amp;nbsp;&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;code se infrastructure banana&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;213&quot; data-end=&quot;364&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;489&quot; data-end=&quot;508&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Multiple clouds&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;- AWS, Azure, GCP sab par kaam karta h&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;213&quot; data-end=&quot;364&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Ek hi code likh ke&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;213&quot; data-end=&quot;364&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1&amp;nbsp;AWS me server bana sakte ho&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;213&quot; data-end=&quot;364&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2&amp;nbsp;Azure me database bana sakte ho&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;213&quot; data-end=&quot;364&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;3&amp;nbsp;GCP me network bana sakte ho&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
