        <mxCell id="sAj-MIZ9R8ZtpeCVmf4z-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;br&gt;&lt;div&gt;External&lt;br&gt;Dependency&lt;br&gt;(Explicit)&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
