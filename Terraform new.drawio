        <mxCell id="sAj-MIZ9R8ZtpeCVmf4z-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;align=left;fillColor=#f8cecc;strokeColor=#b85450;" value="1 State file ko le jayege remote&lt;br&gt;storage A/c pr.&lt;div&gt;&lt;br&gt;a Phle banana hoga resource&lt;br&gt;group&lt;/div&gt;&lt;div&gt;&amp;nbsp; &lt;br&gt;b Phir uske andar storage A/c&lt;br&gt;banana hoga&lt;/div&gt;&lt;div&gt;&lt;br&gt;c Storage A/c Banane k liye Rg&lt;br&gt;group hona chahiye.&lt;/div&gt;&lt;div&gt;&lt;br&gt;d Kahi na kahi esa krna&lt;br&gt;padega Storage A/c k block k&lt;br&gt;andar ki Storage A/c bd me&lt;br&gt;bane phle Rg bane.&lt;/div&gt;" vertex="1">
          <mxGeometry height="450" width="280" x="800" y="9400" as="geometry" />
