        <mxCell id="T4bumHaWE8J8h5Wu4895-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#bac8d3;strokeColor=#23445d;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform Variable&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform Variable kya hota hai?&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;p data-start=&quot;56&quot; data-end=&quot;228&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span class=&quot;hover:entity-accent entity-underline inline cursor-pointer align-baseline&quot;&gt;Terraform&lt;/span&gt; me &lt;strong data-start=&quot;97&quot; data-end=&quot;109&quot;&gt;Variable&lt;/strong&gt; ek container ya box ki tarah hota hai jisme hum value store karte hain.&lt;br data-start=&quot;181&quot; data-end=&quot;184&quot;&gt;&lt;br&gt;Ye value baad me code ke andar use hoti hai.&lt;/font&gt;&lt;/p&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Prblm&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-start=&quot;388&quot; data-end=&quot;437&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Maan lo aap AWS me EC2 instance banana chahte ho.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Agar aap directly value likh do&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;resource &quot;aws_instance&quot; &quot;myserver&quot; {&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; instance_type = &quot;t2.micro&quot;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;}&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Ab prblm - 1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Kal &lt;/span&gt;&lt;code data-start=&quot;583&quot; data-end=&quot;593&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;t2.micro&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; ki jagah &lt;/span&gt;&lt;code data-start=&quot;603&quot; data-end=&quot;613&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;t2.large&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; chahiye ho&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Dev aur Production me alag size chahiye ho&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;To har baar code change karna padega&amp;nbsp;❌&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Isi problem ko solve karta hai &lt;strong data-start=&quot;742&quot; data-end=&quot;754&quot;&gt;Variable&lt;/strong&gt; ✅&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Variable ka use&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;variable &quot;instance_type&quot; {&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; default = &quot;t2.micro&quot;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;}&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;resource &quot;aws_instance&quot; &quot;myserver&quot; {&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; instance_type = var.instance_type&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;}&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Variable banana -&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;variable &quot;instance_type&quot;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Yaha hum Terraform ko bol rahe.&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&quot;Ek variable banao jiska naam &lt;code data-start=&quot;1116&quot; data-end=&quot;1131&quot;&gt;instance_type&lt;/code&gt; hai&quot;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;2&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Default value dena -&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;default = &quot;t2.micro&quot;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Agar user koi value na de, to Terraform automatically &lt;code data-start=&quot;1269&quot; data-end=&quot;1279&quot;&gt;t2.micro&lt;/code&gt; use karega&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;3&amp;nbsp; Variable use karna -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;instance_type = var.instance_type&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;&lt;code data-start=&quot;1383&quot; data-end=&quot;1389&quot;&gt;var.&lt;/code&gt; ka matlab&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&quot;Variable ki value use karo&quot;&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;471&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;To yaha actual value ban jayegi&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1360" width="540" x="1080" y="80" as="geometry" />
        </mxCell>
        <mxCell id="T4bumHaWE8J8h5Wu4895-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad9d5;strokeColor=#ae4132;fontSize=20;align=left;" value="&lt;b&gt;Variables kyun important hain?&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1&amp;nbsp;&amp;nbsp;Reusability -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Ek hi code baar baar use kar sakte ho.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Flexibility -&amp;nbsp;&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Sirf value change karo.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3&amp;nbsp;&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="280" width="180" x="2080" y="80" as="geometry" />
        </mxCell>
        <mxCell id="T4bumHaWE8J8h5Wu4895-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;align=left;" value="&lt;b&gt;Why Variables are Important?&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;1&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Makes code reusable&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Avoids hardcoding&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Easy to manage different environments&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Only values change, code remains same&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="250" x="2280" y="80" as="geometry" />
        </mxCell>
        <mxCell id="T4bumHaWE8J8h5Wu4895-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform Variable&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;What is a Terraform Variable?&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-start=&quot;56&quot; data-end=&quot;125&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;A Terraform variable is like a container or box used to store values.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;127&quot; data-end=&quot;181&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;These values are later used inside the Terraform code.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;127&quot; data-end=&quot;181&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Prblm&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;209&quot; data-end=&quot;259&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Suppose you want to create an EC2 instance in AWS.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;127&quot; data-end=&quot;181&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;If you directly write the value in the code.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;261&quot; data-end=&quot;305&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;resource &quot;aws_instance&quot; &quot;myserver&quot; {&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;261&quot; data-end=&quot;305&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; instance_type = &quot;t2.micro&quot;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;261&quot; data-end=&quot;305&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;}&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;261&quot; data-end=&quot;305&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Prblms - 1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Tomorrow you may need &lt;/span&gt;&lt;code data-start=&quot;437&quot; data-end=&quot;447&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;t2.large&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; instead of &lt;/span&gt;&lt;code data-start=&quot;459&quot; data-end=&quot;469&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;t2.micro&lt;/code&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;261&quot; data-end=&quot;305&quot;&gt;&lt;code data-start=&quot;459&quot; data-end=&quot;469&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2&amp;nbsp;Dev and Production environments may require different instance sizes&lt;/font&gt;&lt;/code&gt;&lt;/p&gt;&lt;p data-start=&quot;261&quot; data-end=&quot;305&quot;&gt;&lt;code data-start=&quot;459&quot; data-end=&quot;469&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Then you will have to change the code again and again ❌&lt;/font&gt;&lt;/code&gt;&lt;/p&gt;&lt;p data-start=&quot;261&quot; data-end=&quot;305&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;code data-start=&quot;459&quot; data-end=&quot;469&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/code&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;600&quot; data-end=&quot;640&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform Variables solve this problem ✅&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="760" width="420" x="1640" y="80" as="geometry" />
        </mxCell>
        <mxCell id="kuPGtM-lms9-EqfliVAR-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3c800;fontColor=#000000;strokeColor=#B09500;" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Dynamic Value&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Dynamic value kya hoti h -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Aisi value jo fix na ho, situation ke according change ho sake.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Simple -&amp;nbsp; 1&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;strong data-start=&quot;157&quot; data-end=&quot;173&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Static Value&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; = hamesha same&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;191&quot; data-end=&quot;208&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Dynamic Value&lt;/strong&gt;&lt;span style=&quot;background-