        <mxCell id="ba29VH0lC1hi8xZmFFrh-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=20;align=left;gradientColor=#97d077;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237));&quot;&gt;Terraform Init&lt;/b&gt;&lt;/div&gt; &lt;br&gt;&lt;b&gt;1 Terraform init kya hota h - &lt;/b&gt;Terraform init ek&lt;br&gt;command hai jo Terraform project ko &lt;b&gt;start&lt;br&gt;(initialize) &lt;/b&gt;karne ke liye use hoti h&lt;br&gt;&lt;b&gt;Simple&lt;/b&gt;&lt;br&gt;terraform init ka matlab hai project ko use karne ke&lt;br&gt;liye ready karna&lt;br&gt;&lt;b&gt;Ye kya-kya kaam karta h&lt;/b&gt;&lt;br&gt;Jab tum terraform init run karte ho, to ye&lt;br&gt;1 Providers download karta h&lt;br&gt;(jaise AWS, Azure, GCP)&lt;br&gt;2 Backend setup karta h&lt;br&gt;(state file kaha store hogi)&lt;br&gt;&lt;b&gt;3 Modules download karta hai &lt;/b&gt;(agar use kiye ho)&lt;br&gt;&lt;b&gt;Ex -&lt;/b&gt; 1 Tum game install karte ho pehle&lt;br&gt;2 Tabhi game chalti h&lt;br&gt;&lt;b&gt;terraform init -&lt;/b&gt; setup/install step before using&lt;br&gt;Terraform" vertex="1">
          <mxGeometry height="560" width="480" x="400" y="4720" as="geometry" />
        </mxCell>
        <mxCell id="ba29VH0lC1hi8xZmFFrh-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform Init&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;What is &lt;code data-start=&quot;24&quot; data-end=&quot;40&quot;&gt;terraform init -&amp;nbsp;&lt;/code&gt;&lt;/b&gt;&lt;code data-start=&quot;44&quot; data-end=&quot;60&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;terraform init&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; is a command used to initialize and prepare a Terraform project before using it.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Simple -&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;code data-start=&quot;153&quot; data-end=&quot;169&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;terraform init&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; means preparing the project to use Terraform.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;What does it do?&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;When you run &lt;code data-start=&quot;248&quot; data-end=&quot;264&quot;&gt;terraform init&lt;/code&gt;, it&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1&amp;nbsp;Downloads providers&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;(such as AWS, Azure, and GCP)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2&amp;nbsp;Sets up the backend&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;(where the state file will be stored)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;3&amp;nbsp;Downloads modules&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;(if modules are used in the project)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="560" width="400" x="920" y="4720" as="geometry" />
        </mxCell>
        <mxCell id="y5oC0jycFWUP5E_PDjlG-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform Validate&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b style=&quot;&quot;&gt;2 Terraform Validate kya hota h &lt;br&gt; terraform validate&lt;/b&gt; ek&lt;br&gt;command hai jo Terraform code ko&lt;br&gt;&lt;b style=&quot;&quot;&gt;check (validate) &lt;/b&gt;karti h&lt;br&gt;&lt;b style=&quot;&quot;&gt;Simple -&lt;/b&gt; terraform validate ka&lt;br&gt;matlab hai — code sahi likha hai ya&lt;br&gt;nahi check karna&lt;br&gt;&lt;b style=&quot;&quot;&gt;Ye kya check krta h&lt;/b&gt;&lt;br&gt;1  Syntax sahi hai ya nahi&lt;br&gt;&lt;b style=&quot;&quot;&gt;Syntax kya hota h -&lt;/b&gt; Syntax ka&lt;br&gt;matlab hota hai kisi bhi programming&lt;br&gt;language ya command ko likhne ka&lt;br&gt;sahi rule/format &lt;br&gt;2 Configuration valid hai ya nahi&lt;br&gt;3 Koi basic error to nahi h&lt;br&gt;1 Ye resources create nahi karta&lt;br&gt;2 Ye plan ya apply nahi karta&lt;br&gt;&lt;b style=&quot;&quot;&gt;Ex -&lt;/b&gt; 1 Exam se pehle tum apna&lt;br&gt;paper check karte ho&lt;br&gt;&lt;b style=&quot;&quot;&gt;2 terraform validate -&lt;/b&gt; code ko&lt;br&gt;check karna before run&lt;/font&gt;" vertex="1">
          <mxGeometry height="640" width="330" x="1360" y="4720" as="geometry" />
        </mxCell>
        <mxCell id="y5oC0jycFWUP5E_PDjlG-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Terraform Validate&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;code data-start=&quot;23&quot; data-end=&quot;43&quot;&gt;terraform validate&lt;/code&gt; is a Terraform command used to check whether the Terraform code is correct or not.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Simple -&amp;nbsp;&lt;/b&gt;Terraform validate checks the code before running it.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;What does it check?&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;1&amp;nbsp;&lt;/b&gt;Syntax is correct or not&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Syntax means&lt;/b&gt; the correct rules or format for writing code or commands.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2&amp;nbsp;Configuration is valid or not&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;3&amp;nbsp;Any basic errors in the code&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Important Points&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;1&amp;nbsp;&lt;/b&gt;It does not create resources.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2 It does not run &lt;code data-start=&quot;472&quot; data-end=&quot;488&quot;&gt;terraform plan&lt;/code&gt; or &lt;code data-start=&quot;492&quot; data-end=&quot;509&quot;&gt;terraform apply&lt;/code&gt;.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Ex -&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Before an exam, we check our paper for mistakes.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;In the same way, &lt;code data-start=&quot;593&quot; data-end=&quot;613&quot; style=&quot;&quot;&gt;terraform validate&lt;/code&gt; checks the Terraform code before execution.&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="640" width="385" x="1720" y="4720" as="geometry" />
        </mxCell>
        <mxCell id="y5oC0jycFWUP5E_PDjlG-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#ffe6cc;strokeColor=#d79b00;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Terraform Plan&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;3 Terraform Plan kya hota h -&lt;/b&gt; terraform plan ek&lt;br&gt;command hai jo batati hai ki &lt;b&gt;agar aap code run karoge&lt;br&gt;to kya changes hone wale h&lt;/b&gt;&lt;br&gt;&lt;b&gt;Simple -&lt;/b&gt; terraform plan ka matlab hai — apply karne se&lt;br&gt;pehle preview dekhna&lt;br&gt;&lt;b&gt;Ye kya karta h&lt;/b&gt;&lt;br&gt;1 Kaun se resources create honge&lt;br&gt;2  Kaun se update honge&lt;br&gt;3  Kaun se delete honge&lt;br&gt;Matlab pura &lt;b&gt;execution ka preview&lt;/b&gt; dikha deta h&lt;br&gt;&lt;b&gt;Ex -&lt;/b&gt;  1 Tum online order place karne se pehle summary&lt;br&gt;dekhte ho&lt;br&gt;&lt;b&gt;2 terraform plan -&lt;/b&gt; final result ka preview before apply.&lt;br&gt;&lt;b&gt;Imprt Point - &lt;/b&gt;1 Ye sirf &lt;b&gt;check karta hai,&lt;/b&gt; actual me kuch&lt;br&gt;create nahi karta&lt;br&gt;2 Real execution hota h - terraform apply&lt;/font&gt;" vertex="1">
          <mxGeometry height="760" width="360" x="2120" y="4720" as="geometry" />
        </mxCell>
        <mxCell id="y5oC0jycFWUP5E_PDjlG-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;16&quot; style=&quot;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform Plan&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;16&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform plan is a command that shows what changes Terraform will make before deployment.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;16&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;h3 data-section-id=&quot;j23ir4&quot; data-start=&quot;185&quot; data-end=&quot;207&quot;&gt;&lt;/h3&gt;&lt;p&gt;&lt;/p&gt;&lt;p data-start=&quot;112&quot; data-end=&quot;183&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Simple —&lt;/b&gt; it gives a preview before running &lt;code data-start=&quot;163&quot; data-end=&quot;180&quot;&gt;terraform apply&lt;/code&gt;.&lt;/font&gt;&lt;/p&gt;&lt;h3 data-section-id=&quot;j23ir4&quot; data-start=&quot;185&quot; data-end=&quot;207&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;What does it show?&lt;/font&gt;&lt;/h3&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1&amp;nbsp;Which resources will be created&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2&amp;nbsp;Which resources will be updated&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;3&amp;nbsp;Which resources will be deleted&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;It shows the complete execution preview&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Ex -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Like when you place an online order, you first see the order summary before confirming.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;In the same way, &lt;/span&gt;&lt;code data-start=&quot;483&quot; data-end=&quot;499&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;terraform plan&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; shows the final result preview before apply.&lt;/span&gt;&lt;/div&gt;&lt;/span&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Imprt Points&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;1&amp;nbsp;&lt;/b&gt;It only checks and shows changes, it does not create anything.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;Actual resource creation happens when we run.&lt;/span&gt;&lt;/div&gt;&lt;p data-start=&quot;18&quot; data-end=&quot;110&quot;&gt;&lt;/p&gt;&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="760" width="400" x="2520" y="4720" as="geometry" />
        </mxCell>
        <mxCell id="y5oC0jycFWUP5E_PDjlG-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;gradientColor=#ffd966;strokeColor=#d6b656;align=left;fontSize=20;" value="&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Terraform Apply&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;b&gt;Terraform Apply kya hota h -&lt;/b&gt; terraform&lt;br&gt;apply wo command hai jo &lt;b&gt;actual me&lt;br&gt;infrastructure create, update ya delete&lt;br&gt;karti h&lt;/b&gt;&lt;br&gt;&lt;b&gt;Simple -&lt;/b&gt; terraform apply ka matlab hai — jo&lt;br&gt;plan me dikhaya tha usko real me execute&lt;br&gt;karna&lt;br&gt;&lt;b&gt; Ye kya karta h&lt;/b&gt;&lt;br&gt;1 Resources create karta h&lt;br&gt;2 Existing resources update karta h&lt;br&gt;3 Unwanted resources delete karta h&lt;br&gt;Matlab jo bhi changes terraform plan&lt;br&gt;me dikhe the, unhe &lt;b&gt;real me apply&lt;/b&gt; kar deta&lt;br&gt;&lt;b&gt;Imprt Point -&lt;/b&gt; 1 Ye command &lt;b&gt;actual&lt;/b&gt;&lt;br&gt;&lt;b&gt;changes karti hai&lt;/b&gt; (real resources banenge)&lt;br&gt;2 Isliye use karne se pehle &lt;b&gt;plan check&lt;br&gt;karna zaroori h&lt;/b&gt;&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="560" width="410" x="30" y="5400" as="geometry" />
        </mxCell>
        <mxCell id="y5oC0jycFWUP5E_PDjlG-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform Apply&amp;nbsp;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;p data-start=&quot;19&quot; data-end=&quot;118&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform apply is a command that actually creates, updates, or deletes infrastructure resources.&lt;/font&gt;&lt;/p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;120&quot; data-end=&quot;203&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Simple — &lt;/b&gt;it executes the changes that were shown in the &lt;code data-start=&quot;184&quot; data-end=&quot;200&quot;&gt;terraform plan&lt;/code&gt;.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;120&quot; data-end=&quot;203&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;What does it do?&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;120&quot; data-end=&quot;203&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Creates new resources&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;120&quot; data-end=&quot;203&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Updates existing resources&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;120&quot; data-end=&quot;203&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Deletes unwanted resources&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;120&quot; data-end=&quot;203&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;It applies all the changes in real infrastructure that were shown in the Terraform plan.&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;120&quot; data-end=&quot;203&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Imprt Point - 1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;This command makes actual changes, so real resources will be created or modified.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;120&quot; data-end=&quot;203&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;2&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;That’s why it is important to check &lt;/span&gt;&lt;code data-start=&quot;557&quot; data-end=&quot;573&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;terraform plan&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; before running&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="680" width="360" x="462" y="5400" as="geometry" />
        </mxCell>
