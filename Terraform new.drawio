        <mxCell id="sAj-MIZ9R8ZtpeCVmf4z-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;Depends on&lt;br&gt;meta argument&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="120" x="2160" y="9640" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-6" edge="1" parent="1" source="sAj-MIZ9R8ZtpeCVmf4z-26" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="2520" y="10280" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="sAj-MIZ9R8ZtpeCVmf4z-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#e6d0de;gradientColor=#d5739d;strokeColor=#996185;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;Implicit Dependency (Internal)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Implicit Dependency kya hoti h?&lt;/b&gt;&lt;br&gt;Jab Terraform khud samajh jata hai ki ek&lt;br&gt;resource dusre par depend h.&lt;br&gt;Ye tab hota hai jab tum directly kisi resource ka&lt;b&gt; attribute&lt;/b&gt; use karte ho.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;Yaha Terraform ko automatically pata h&lt;br&gt;1 Storage account → Resource group ke baad&lt;br&gt;hi banega.&lt;br&gt;kyunki tumne&lt;br&gt;azurerm_resource_group.mango.name&lt;br&gt;use kiya&lt;br&gt;Isko bolte hai &lt;b&gt;implicit dependency&lt;/b&gt;&lt;br&gt;(automatic) 1 Rg Create &lt;br&gt;2 Storage A/c&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;b&gt;Attribute kya hota hai?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;Attribute = kisi resource ki property (details /&lt;br&gt;features)&lt;br&gt;Matlab resource ke andar jo bhi values hoti&lt;br&gt;hain, unko &lt;b&gt;attribute&lt;/b&gt; bolte h.&lt;br&gt;name → attribute&lt;br&gt;location → attribute&lt;br&gt;Ye dono resource ki properties h&lt;br&gt;Ex - Agar tum ek form fill karte ho:&lt;br&gt;1 Name 2 Age 3 Address&lt;br&gt;Ye sab&lt;b&gt; attributes&lt;/b&gt; hain tumhare&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="840" width="400" x="2320" y="9400" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;h2 data-section-id=&quot;n15joj&quot; data-start=&quot;0&quot; data-end=&quot;33&quot; style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/h2&gt;&lt;h2 data-section-id=&quot;n15joj&quot; data-start=&quot;0&quot; data-end=&quot;33&quot; style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Implicit Dependency (Internal)&lt;/font&gt;&lt;/h2&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;h2 data-section-id=&quot;n15joj&quot; data-start=&quot;0&quot; data-end=&quot;33&quot; style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px;&quot;&gt;What is Implicit Dependency?&lt;/span&gt;&lt;/h2&gt;&lt;p data-start=&quot;68&quot; data-end=&quot;176&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Implicit Dependency means Terraform automatically understands that one resource depends on another resource.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;This happens when you use the attribute of one resource inside another resource.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Ex -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Terraform automatically knows&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;First create the Resource Group&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Then create the Storage Account&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Because the Storage Account is using&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;azurerm_resource_group.mango.name&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;So Terraform understands the dependency automatically.&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;This is called &lt;strong data-start=&quot;524&quot; data-end=&quot;571&quot;&gt;Implicit Dependency (Automatic Dependency).&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;strong data-start=&quot;524&quot; data-end=&quot;571&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;What is an Attribute?&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;strong data-start=&quot;524&quot; data-end=&quot;571&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Attribute means the property or detail of a resource.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;strong data-start=&quot;524&quot; data-end=&quot;571&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;The values inside a resource are called attributes.&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;strong data-start=&quot;524&quot; data-end=&quot;571&quot;&gt;Ex - 1&amp;nbsp;&lt;/strong&gt;&lt;code data-start=&quot;727&quot; data-end=&quot;733&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;name&lt;/b&gt;&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&amp;nbsp;-&amp;nbsp;&lt;/b&gt;attribute&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;code data-start=&quot;750&quot; data-end=&quot;760&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;location&lt;/code&gt;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&amp;nbsp;-&lt;/b&gt; attribute&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;These are properties of the resource.&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;178&quot; data-end=&quot;258&quot; style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="850" width="520" x="2760" y="9390" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-12" edge="1" parent="1" source="cO7E2ySzeze0lpIjGBvW-2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="235" y="10960" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <UserObject label="&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Explicit Dependency (External)&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Explicit Dependency kya hoti h ?&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Jab Terraform &lt;b&gt;khud detect nahi kar pata,&lt;/b&gt; lekin&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;logically dependency hoti h.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Tab tum manually batate ho using depends_on&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&quot;azurerm_resource_group&quot; &quot;rg&quot; {&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;name = &quot;my-rg&quot;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;location = &quot;East US&quot;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;}&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;resource &quot;null_resource&quot; &quot;example&quot; {&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;depends_on =&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;[azurerm_resource_group.rg]&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;}&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Yaha koi attribute use nahi ho raha.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Terraform ko nahi pata ki dependency h.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Isliye tumne manually likha depends_on.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Isko bolte hai&amp;nbsp;&lt;b&gt;explicit&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;dependency&lt;/b&gt;&amp;nbsp;(manual)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;resource&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;Isko bolte hai &lt;b&gt;explicit dependency&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;(manual)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Easy&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp;Implicit → Terraform khud samjhe (reference&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;use kiya)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2 Explicit → Tum batate ho (depends_on use&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;kiya)&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Real life Ex - 1 Implicit: Tum bolte ho “chai bana&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;do aur milk use karo” → automatically samajh aa&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;gaya milk chahiye&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2 Explicit: Tum bolte ho “pehle milk leke aao, fir&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;chai banao” → clearly instruction diya&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;div style=&quot;text-align: left;&quot;&gt;&lt;br&gt;&lt;/div&gt;" link="&#xa;Explicit Dependency (External)&#xa;Explicit Dependency kya hoti h ? &#xa;Jab Terraform khud detect nahi kar pata, lekin&#xa;logically dependency hoti h.&#xa;Tab tum manually batate ho using depends_on&#xa;&quot;azurerm_resource_group&quot; &quot;rg&quot; {&#xa;name = &quot;my-rg&quot;&#xa;location = &quot;East US&quot;&#xa;}&#xa;resource &quot;null_resource&quot; &quot;example&quot; {&#xa;depends_on =&#xa;[azurerm_resource_group.rg]&#xa;}&#xa;Yaha koi attribute use nahi ho raha.&#xa;Terraform ko nahi pata ki dependency h.&#xa;Isliye tumne manually likha depends_on.&#xa;Isko bolte hai&amp;nbsp;explicit&#xa;dependency&amp;nbsp;(manual)&#xa;resource&#xa;&amp;nbsp;Isko bolte hai explicit dependency&#xa;(manual)&#xa;Easy&amp;nbsp;&#xa;1&amp;nbsp;Implicit → Terraform khud samjhe (reference&#xa;use kiya)&#xa;2 Explicit → Tum batate ho (depends_on use&#xa;kiya)&#xa;Real life Ex - 1 Implicit: Tum bolte ho “chai bana&#xa;do aur milk use karo” → automatically samajh aa&#xa;gaya milk chahiye&#xa;2 Explicit: Tum bolte ho “pehle milk leke aao, fir&#xa;chai banao” → clearly instruction diya&#xa;&#xa;" id="cO7E2ySzeze0lpIjGBvW-2">
          <mxCell parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcd28;gradientColor=#ffa500;strokeColor=#d79b00;" vertex="1">
            <mxGeometry height="1010" width="410" x="30" y="9910" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-5" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="208.72" width="380" x="2360" y="10279" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-7" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="283.94" width="402" x="30" y="10960" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;" value="&lt;h2 data-section-id=&quot;d7xzc0&quot; data-start=&quot;0&quot; data-end=&quot;33&quot; style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Explicit Dependency (External)&lt;/font&gt;&lt;/h2&gt;&lt;h3 data-section-id=&quot;1nxagi8&quot; data-start=&quot;35&quot; data-end=&quot;67&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;What is Explicit Dependency?&lt;/font&gt;&lt;/h3&gt;&lt;p data-start=&quot;68&quot; data-end=&quot;194&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Explicit Dependency means Terraform cannot automatically detect the dependency, but logically one resource depends on another.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;So we manually tell Terraform by using &lt;code data-start=&quot;235&quot; data-end=&quot;247&quot;&gt;depends_on&lt;/code&gt;.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Ex -&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;resource &quot;azurerm_resource_group&quot; &quot;rg&quot; {&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; name&amp;nbsp; &amp;nbsp; &amp;nbsp;= &quot;my-rg&quot;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; location = &quot;East US&quot;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;}&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;resource &quot;null_resource&quot; &quot;example&quot; {&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; depends_on = [azurerm_resource_group.rg]&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;}&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Explanation&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;461&quot; data-end=&quot;494&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Here, no attribute is being used.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;496&quot; data-end=&quot;556&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;So Terraform cannot understand the dependency automatically.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;558&quot; data-end=&quot;587&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;That’s why we manually wrote:&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;589&quot; data-end=&quot;601&quot;&gt;&lt;code data-start=&quot;589&quot; data-end=&quot;601&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;depends_on&lt;/font&gt;&lt;/code&gt;&lt;/p&gt;&lt;p data-start=&quot;196&quot; data-end=&quot;248&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;This is called &lt;/span&gt;&lt;strong data-start=&quot;618&quot; data-end=&quot;662&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Explicit Dependency (Manual Dependency).&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;603&quot; data-end=&quot;662&quot;&gt;&lt;strong data-start=&quot;618&quot; data-end=&quot;662&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Easy Difference&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p data-start=&quot;603&quot; data-end=&quot;662&quot;&gt;&lt;strong data-start=&quot;618&quot; data-end=&quot;662&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1&amp;nbsp;Implicit Dependency&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;&lt;p data-start=&quot;603&quot; data-end=&quot;662&quot;&gt;&lt;span data-start=&quot;618&quot; data-end=&quot;662&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Terraform understands automatically because a reference or attribute is used.&lt;/font&gt;&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;603&quot; data-end=&quot;662&quot;&gt;&lt;span data-start=&quot;618&quot; data-end=&quot;662&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2&amp;nbsp;Explicit Dependency&lt;/font&gt;&lt;/b&gt;&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;603&quot; data-end=&quot;662&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span data-start=&quot;618&quot; data-end=&quot;662&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;822&quot; data-end=&quot;869&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;You manually tell Terraform using &lt;code data-start=&quot;856&quot; data-end=&quot;868&quot;&gt;depends_on&lt;/code&gt;.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;822&quot; data-end=&quot;869&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Real-Life Example&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;822&quot; data-end=&quot;869&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Implicit Dependency&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;822&quot; data-end=&quot;869&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;You say&amp;nbsp; -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;“Make tea using milk.”&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;955&quot; data-end=&quot;1012&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Automatically it is understood that milk is needed first.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;955&quot; data-end=&quot;1012&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Explicit Dependency&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;1038&quot; data-end=&quot;1081&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;You say&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;1038&quot; data-end=&quot;1081&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;“First bring milk, then make tea.”&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;955&quot; data-end=&quot;1012&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Here you clearly gave instructions manually.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="1400" width="480" x="480" y="9920" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;1 .tf file&amp;nbsp;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2 .tf state file&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;3 Azure portal&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1 Teeno state me barabar (equal) h to zero drift state hoga (Equibilirium state).&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2 Agar kisi bhi ek state me kuch bhi hatega to vaha pe drift aayega.&amp;nbsp;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="360" width="200" x="1000" y="9920" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=20;" value="&lt;div&gt;&lt;font&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font&gt;&lt;b&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Meta Argument&lt;/b&gt;&lt;/div&gt;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;h2 data-section-id=&quot;162e9pm&quot; data-start=&quot;0&quot; data-end=&quot;29&quot;&gt;Meta Argument in Terraform&lt;/h2&gt;&lt;p data-start=&quot;31&quot; data-end=&quot;126&quot;&gt;Meta Argument Terraform ka special argument hota hai jo resource ka behavior control karta hai.&lt;/p&gt;&lt;p data-start=&quot;128&quot; data-end=&quot;226&quot;&gt;&lt;b&gt;Simple words:&lt;/b&gt;&lt;br&gt;&lt;br&gt;Meta arguments decide karte hain ki resource kaise create, manage, ya depend karega.&lt;/p&gt;&lt;p data-start=&quot;228&quot; data-end=&quot;272&quot;&gt;Ye normal resource settings nahi hote jaise.&lt;/p&gt;&lt;p data-start=&quot;228&quot; data-end=&quot;272&quot;&gt;1 Name 2 Location&lt;/p&gt;&lt;p data-start=&quot;228&quot; data-end=&quot;272&quot;&gt;Ye Terraform ko instructions dete h.&lt;/p&gt;&lt;h2 data-section-id=&quot;10jv024&quot; data-start=&quot;1209&quot; data-end=&quot;1241&quot;&gt;Easy Definition for Interview&lt;/h2&gt;&lt;h2 data-section-id=&quot;10jv024&quot; data-start=&quot;1209&quot; data-end=&quot;1241&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px; font-weight: normal;&quot;&gt;Meta Argument is a special Terraform argument used to control the behavior of resources, such as dependency, lifecycle, and multiple resource creation.&lt;/span&gt;&lt;/h2&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Meta Argument -&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; Depends block&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="820" width="480" x="1240" y="9920" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f8cecc;strokeColor=#b85450;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Imprt for interview&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1 Jaise hi aap plan chalate ho to sabse phle terraform refresh chalta h.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;2 Plan - &lt;/b&gt;Terraform refresh + terraform plan&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;3 Refresh - &lt;/b&gt;Portal aur state file ko equibilirium state par le aata h.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b style=&quot;&quot;&gt;4 Apply - &lt;/b&gt;refresh + terraform plan + Approval + terraform apply&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="250" x="995" y="10760" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#bac8d3;strokeColor=#23445d;" value="&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Agar bana banaya resource ka naam update ho gya to kya hoga?&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Phle destroy hoga phir recreate karega esi ko replace bolte h.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Agar location change karege to kya hoga ?&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;a &lt;/b&gt;Phle purani location destory karega phir new location recreate karege.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;b &lt;/b&gt;kbhi bhi terraform destroy ni chalna h.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b style=&quot;&quot;&gt;c &lt;/b&gt;phle code se resource hata denge fir terraform apply run kara dege.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="480" width="320" x="2640" y="10720" as="geometry" />
        </mxCell>
        <mxCell id="cO7E2ySzeze0lpIjGBvW-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#bac8d3;strokeColor=#23445d;align=left;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;Aap state file ko local me na rakh k remote storage A/c me securely rkh skte ho azure me storage A/c 99.99% SLA provide krta h.&lt;/font&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;SLA Full Form -&lt;/b&gt;&amp;nbsp;&lt;span data-start=&quot;42&quot; data-end=&quot;69&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Service Level Agreement&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Simple -&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Ye company ka promise hota hai ki service kitni available aur reliable rahegi.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Ex -&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Agar Azure Storage Account 99.99% SLA deta hai, iska matlab.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Service almost hamesha available rahegi aur downtime bahut kam hoga.&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;99.99% SLA ≈ bahut high availability&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
