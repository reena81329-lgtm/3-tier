tyle: initial; text-decoration-color: initial; text-align: left;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b style=&quot;forced-color-adjust: none;&quot;&gt;2&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;741&quot; data-end=&quot;757&quot; style=&quot;forced-color-adjust: none; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Google Drive -&amp;nbsp;&lt;/strong&gt;&lt;span style=&quot;forced-color-adjust: none; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Files online store hoti hain.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-align: left;&quot;&gt;&lt;b style=&quot;forced-color-adjust: none;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3&amp;nbsp;&lt;/span&gt;&lt;span data-start=&quot;793&quot; data-end=&quot;834&quot; style=&quot;forced-color-adjust: none; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Amazon Web Services, Microsoft Azure&lt;/span&gt;&lt;/b&gt;&lt;span style=&quot;forced-color-adjust: none; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b style=&quot;forced-color-adjust: none;&quot;&gt;&amp;nbsp;-&lt;/b&gt;&amp;nbsp;Companies apni websites aur apps chalati hain.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-align: left;&quot;&gt;&lt;span style=&quot;forced-color-adjust: none; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br style=&quot;forced-color-adjust: none;&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;forced-color-adjust: none; color: rgb(0, 0, 0); font-family: Helvetica; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(236, 236, 236); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; text-align: left;&quot;&gt;&lt;strong data-start=&quot;1196&quot; data-end=&quot;1213&quot; style=&quot;forced-color-adjust: none;&quot;&gt;Cloud = jagah&lt;/strong&gt;&lt;br data-start=&quot;1213&quot; data-end=&quot;1216&quot; style=&quot;forced-color-adjust: none;&quot;&gt;&lt;strong data-start=&quot;1219&quot; data-end=&quot;1256&quot; style=&quot;forced-color-adjust: none;&quot;&gt;Cloud Computing = us jagah ka use&lt;/strong&gt;&lt;/div&gt;&lt;br&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="305" x="1120" y="40" as="geometry" />
        </mxCell>
        <mxCell id="P042gj2qJb73r6g-kuzl-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=16;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cloud Flare&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Cloud Flare -&amp;nbsp;&lt;/b&gt;&lt;strong data-start=&quot;0&quot; data-end=&quot;41&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cloudflare&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; ek &lt;/span&gt;&lt;strong data-start=&quot;45&quot; data-end=&quot;73&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;internet service company&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; hai jo websites ko &lt;/span&gt;&lt;strong data-start=&quot;93&quot; data-end=&quot;129&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;secure (safe), fast aur reliable&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; banane me help karti h&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Simple&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Agar aapki &lt;/span&gt;&lt;strong data-start=&quot;194&quot; data-end=&quot;213&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;website ek ghar&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; hai, to &lt;/span&gt;&lt;strong data-start=&quot;222&quot; data-end=&quot;278&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cloudflare us ghar ka security guard + speed booster&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; h&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Short mai&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Cloudflare -&lt;/b&gt;&amp;nbsp;&lt;/span&gt;&lt;span data-start=&quot;1129&quot; data-end=&quot;1170&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Website security + speed + protection&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Cloudflare kya krta h&lt;/b&gt;&lt;/div&gt;&lt;div&gt;1&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Website ko &lt;/span&gt;&lt;span data-start=&quot;339&quot; data-end=&quot;365&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;hackers se bachata h&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;339&quot; data-end=&quot;365&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Website ki &lt;/span&gt;&lt;span data-start=&quot;483&quot; data-end=&quot;507&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;speed fast krta h&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;483&quot; data-end=&quot;507&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cloudflare duniya bhar ke &lt;strong data-start=&quot;534&quot; data-end=&quot;545&quot;&gt;servers&lt;/strong&gt; ka use karta hai jisse website jaldi load hoti h&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;strong data-start=&quot;483&quot; data-end=&quot;507&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3&amp;nbsp;&lt;/strong&gt;&lt;span data-start=&quot;483&quot; data-end=&quot;507&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Security firewall deta h&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;483&quot; data-end=&quot;507&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Isme &lt;strong data-start=&quot;643&quot; data-end=&quot;677&quot;&gt;Web Application Firewall (WAF)&lt;/strong&gt; hota hai jo dangerous traffic ko block karta h&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;483&quot; data-end=&quot;507&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4&amp;nbsp;CDN provide kata h&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;483&quot; data-end=&quot;507&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Cloudflare &lt;strong data-start=&quot;774&quot; data-end=&quot;821&quot;&gt;&lt;span class=&quot;hover:entity-accent entity-underline inline cursor-pointer align-baseline&quot;&gt;&lt;span class=&quot;whitespace-normal&quot;&gt;Content Delivery Network&lt;/span&gt;&lt;/span&gt; (CDN)&lt;/strong&gt; use karta hai jisse website ka data nearest server se load hota h&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;483&quot; data-end=&quot;507&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Ex -&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Agar koi website &lt;/span&gt;&lt;strong data-start=&quot;929&quot; data-end=&quot;950&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;India me host hai&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; aur koi user &lt;/span&gt;&lt;strong data-start=&quot;964&quot; data-end=&quot;989&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;USA se open karta hai&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, to Cloudflare usko &lt;/span&gt;&lt;strong data-start=&quot;1010&quot; data-end=&quot;1050&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;nearest server se data bhej deta h&lt;/strong&gt;&lt;/div&gt;&lt;div&gt;&lt;span data-start=&quot;1010&quot; data-end=&quot;1050&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Isse website &lt;span data-start=&quot;1067&quot; data-end=&quot;1089&quot; style=&quot;&quot;&gt;fast open hoti h.&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="600" width="430" x="1440" y="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="QWOuI84AOL3ACqkwfaty" name="Page-2">
    <mxGraphModel dx="1269" dy="561" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="4681" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="NBtGaCiOh14KMYiGG-WB-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 25px;&quot;&gt;Azure Landing Zone&lt;/font&gt;" vertex="1">
          <mxGeometry height="40" width="320" x="880" as="geometry" />
        </mxCell>
        <mxCell id="NBtGaCiOh14KMYiGG-WB-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fontSize=20;" value="&lt;br&gt;&lt;b&gt;Landing Zone kya hoti hai? (What?)&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Maan lo tum ek naya ghar bana rahe ho.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Ghar banane se pehle tum&lt;/div&gt;&lt;div&gt;1&amp;nbsp;Bijli lagwate ho&lt;/div&gt;&lt;div&gt;2&amp;nbsp;Pani ka connection karwate ho&lt;/div&gt;&lt;div&gt;3&amp;nbsp;Security gate lagwate ho&lt;/div&gt;&lt;div&gt;4&amp;nbsp;Rooms ka plan banate ho&lt;/div&gt;&lt;div&gt;Uske baad hi log ghar mein rehna shuru karte hain.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Azure mein Landing Zone bhi kuch aisi hi hoti hai.&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Jab company Azure cloud use karna chahti hai, to resources (VM, Storage, Database) banane se pehle ek &lt;strong data-start=&quot;464&quot; data-end=&quot;485&quot;&gt;ready environment&lt;/strong&gt; tayar karti hai jise Landing Zone kehte hain.&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="720" width="240" x="40" y="80" as="geometry" />
        </mxCell>
        <mxCell id="NBtGaCiOh14KMYiGG-WB-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=20;" value="&lt;p data-start=&quot;40&quot; data-end=&quot;130&quot;&gt;&lt;strong data-start=&quot;40&quot; data-end=&quot;130&quot;&gt;Azure Landing Zone is a ready environment created before deploying resources in Azure.&lt;/strong&gt;&lt;/p&gt;&lt;p data-start=&quot;40&quot; data-end=&quot;130&quot; style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Just like before building a house, we first arrange electricity, water, security, and planning. After that, people can live in the house.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;277&quot; data-end=&quot;449&quot; style=&quot;text-align: left;&quot;&gt;Similarly, before creating Azure resources like Virtual Machines (VMs), Storage Accounts, and Databases, a company sets up security, networking, governance, and management.&lt;/p&gt;&lt;p data-start=&quot;277&quot; data-end=&quot;449&quot; style=&quot;text-align: left;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;This prepared cloud environment is called an &lt;/span&gt;&lt;strong data-start=&quot;499&quot; data-end=&quot;521&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Azure Landing Zone&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;454&quot; data-end=&quot;522&quot; style=&quot;text-align: left;&quot;&gt;&lt;b&gt;shor interview -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Azure Landing Zone is a pre-configured cloud environment that provides security, networking, governance, and management before deploying Azure resources.&lt;/span&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="720" width="360" x="320" y="80" as="geometry" />
        </mxCell>
        <mxCell id="NBtGaCiOh14KMYiGG-WB-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;h2 data-section-id=&quot;1k8xlx5&quot; data-start=&quot;538&quot; data-end=&quot;581&quot; style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Landing Zone ki zarurat kyu padi? (Why?)&lt;/font&gt;&lt;/h2&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;583&quot; data-end=&quot;651&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Socho ek company ne bina planning ke Azure use karna shuru kar diya.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;583&quot; data-end=&quot;651&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Prblm&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;❌ Sab log alag-alag resources bana denge&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;583&quot; data-end=&quot;651&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;❌ Security weak ho jayegi&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;583&quot; data-end=&quot;651&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;❌ Bill bahut zyada aa sakta hai&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;583&quot; data-end=&quot;651&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;❌ Data safe nahi rahega&lt;/span&gt;&lt;/p&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;❌ Management mushkil ho jayega&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Isliye pehle Landing Zone banayi jati hai.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Landing Zone ensure karti hai:&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;✅ Security pehle se set ho&lt;br data-start=&quot;928&quot; data-end=&quot;931&quot;&gt;✅ Cost control ho&lt;br data-start=&quot;948&quot; data-end=&quot;951&quot;&gt;✅ Resources organized ho&lt;br data-start=&quot;975&quot; data-end=&quot;978&quot;&gt;✅ Rules sabke liye same ho&lt;br data-start=&quot;1004&quot; data-end=&quot;1007&quot;&gt;✅ Future mein scale karna easy ho&lt;br&gt;&lt;/font&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="840" width="280" x="720" y="80" as="geometry" />
        </mxCell>
        <mxCell id="NBtGaCiOh14KMYiGG-WB-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;h3 data-section-id=&quot;1aqv6v7&quot; data-start=&quot;33&quot; data-end=&quot;74&quot; style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Why do we need an Azure Landing Zone?&lt;/font&gt;&lt;/h3&gt;&lt;p data-start=&quot;76&quot; data-end=&quot;137&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Imagine a company starts using Azure without proper planning.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;This can cause several problems:&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1&amp;nbsp;Security may become weak.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;2&amp;nbsp;Resources may not be organized properly.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;3&amp;nbsp;Cloud costs may increase.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;4&amp;nbsp;Data may not be protected properly.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;5&amp;nbsp;Managing the environment becomes difficult.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Therefore, an &lt;strong data-start=&quot;371&quot; data-end=&quot;393&quot;&gt;Azure Landing Zone&lt;/strong&gt; is created before deploying resources.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;It helps to&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;✅ Set up security from the beginning.&lt;br data-start=&quot;485&quot; data-end=&quot;488&quot;&gt;&lt;br&gt;✅ Control and manage costs.&lt;br data-start=&quot;515&quot; data-end=&quot;518&quot;&gt;&lt;br&gt;✅ Keep resources organized.&lt;br data-start=&quot;545&quot; data-end=&quot;548&quot;&gt;&lt;br&gt;✅ Apply standard rules and policies.&lt;br data-start=&quot;584&quot; data-end=&quot;587&quot;&gt;&lt;br&gt;✅ Make future growth and scaling easier.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;139&quot; data-end=&quot;171&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Short Interview Answer -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Azure Landing Zone is needed to provide a secure, organized, and well-governed Azure environment. It helps manage security, costs, policies, and resources before deploying workloads.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="880" width="400" x="1040" y="80" as="geometry" />
        </mxCell>
        <mxCell id="NBtGaCiOh14KMYiGG-WB-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fontSize=20;" value="&lt;h2 data-section-id=&quot;1ywmm9n&quot; data-start=&quot;1047&quot; data-end=&quot;1091&quot; style=&quot;text-align: center;&quot;&gt;&lt;font&gt;Landing Zone kaise kaam karti hai? (How?)&lt;/font&gt;&lt;/h2&gt;&lt;p data-start=&quot;1093&quot; data-end=&quot;1152&quot;&gt;&lt;font&gt;Maan lo company Azure mein apni website chalana chahti hai.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1154&quot; data-end=&quot;1196&quot;&gt;&lt;font&gt;Landing Zone pehle ye sab setup karti hai:&lt;/font&gt;&lt;/p&gt;&lt;h3 data-section-id=&quot;qykx5y&quot; data-start=&quot;1198&quot; data-end=&quot;1222&quot;&gt;&lt;font&gt;1. Management Groups&lt;/font&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;qykx5y&quot; data-start=&quot;1198&quot; data-end=&quot;1222&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;Resources ko organize karne ke liye folders jaise structure.&lt;/span&gt;&lt;/h3&gt;&lt;p data-start=&quot;1223&quot; data-end=&quot;1283&quot;&gt;&lt;font&gt;&lt;b&gt;Ex -&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;b&gt;Company&lt;/b&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1223&quot; data-end=&quot;1283&quot;&gt;&lt;b&gt;&lt;font&gt;&amp;nbsp;├─ Production&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;1223&quot; data-end=&quot;1283&quot;&gt;&lt;b&gt;&lt;font&gt;&amp;nbsp;└─ Development&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;h3 data-section-id=&quot;1v9n9g9&quot; data-start=&quot;1342&quot; data-end=&quot;1361&quot;&gt;&lt;font&gt;2. Subscription&lt;/font&gt;&lt;/h3&gt;&lt;p data-start=&quot;1362&quot; data-end=&quot;1406&quot;&gt;&lt;font&gt;Alag-alag teams ke liye alag Azure accounts.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1223&quot; data-end=&quot;1283&quot;&gt;&lt;font&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Ex - 1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Dev Subscription&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1408&quot; data-end=&quot;1416&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;2&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Production Subscription&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1408&quot; data-end=&quot;1416&quot;&gt;&lt;font&gt;&lt;b&gt;3. Networking&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1408&quot; data-end=&quot;1416&quot;&gt;&lt;font&gt;Internet aur resources ko connect karne ke rules.&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1408&quot; data-end=&quot;1416&quot;&gt;&lt;font&gt;&lt;b&gt;Ex - 1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Virtual Network (VNet)&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1408&quot; data-end=&quot;1416&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;2&amp;nbsp;&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Subnets&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;h3 data-section-id=&quot;1loh2kq&quot; data-start=&quot;1577&quot; data-end=&quot;1592&quot;&gt;&lt;font&gt;4. Security&lt;/font&gt;&lt;/h3&gt;&lt;p data-start=&quot;1408&quot; data-end=&quot;1416&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Kaun kya access kar sakta hai.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1593&quot; data-end=&quot;1623&quot;&gt;&lt;font&gt;&lt;b&gt;Ex - 1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Admin&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1593&quot; data-end=&quot;1623&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Developer&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1593&quot; data-end=&quot;1623&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Read Only User&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;h3 data-section-id=&quot;1d70luj&quot; data-start=&quot;1672&quot; data-end=&quot;1687&quot;&gt;&lt;font&gt;5. Policies&lt;/font&gt;&lt;/h3&gt;&lt;p data-start=&quot;1593&quot; data-end=&quot;1623&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Rules lagana.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1688&quot; data-end=&quot;1701&quot;&gt;&lt;font&gt;&lt;b&gt;Ex - 1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Sirf India region mein resources banao&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1688&quot; data-end=&quot;1701&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Public access allow na ho&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1688&quot; data-end=&quot;1701&quot;&gt;&lt;font&gt;&lt;b&gt;6. Monitoring&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1688&quot; data-end=&quot;1701&quot;&gt;&lt;font&gt;Sab kuch track karna.&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1688&quot; data-end=&quot;1701&quot;&gt;&lt;font&gt;&lt;b&gt;Ex - 1&amp;nbsp;&lt;/b&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Server down hua?&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;1688&quot; data-end=&quot;1701&quot;&gt;&lt;font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;2&amp;nbsp;&lt;/b&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Kisne resource delete kiya?&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;h2 data-section-id=&quot;k8xkxd&quot; data-start=&quot;2227&quot; data-end=&quot;2256&quot;&gt;Interview Mein Easy Answer&lt;/h2&gt;&lt;h2 data-section-id=&quot;k8xkxd&quot; data-start=&quot;2227&quot; data-end=&quot;2256&quot;&gt;&lt;strong data-start=&quot;2258&quot; data-end=&quot;2460&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px;&quot;&gt;&quot;Landing Zone Azure ka pre-configured environment hota hai jo security, networking, governance aur management ko pehle se setup karta hai taaki resources ko safely aur properly deploy kiya ja sake.&quot;&lt;/strong&gt;&lt;/h2&gt;" vertex="1">
          <mxGeometry height="1760" width="480" x="1480" y="80" as="geometry" />
        </mxCell>
        <mxCell id="NBtGaCiOh14KMYiGG-WB-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;h3 data-section-id=&quot;l5bhbn&quot; data-start=&quot;0&quot; data-end=&quot;62&quot; style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;How does Azure Landing Zone work? (Short Interview Answer)&lt;/font&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;l5bhbn&quot; data-start=&quot;0&quot; data-end=&quot;62&quot; style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px; font-weight: normal;&quot;&gt;Before deploying applications or resources in Azure, the Landing Zone sets up the basic cloud environment:&lt;/span&gt;&lt;/h3&gt;&lt;p data-start=&quot;64&quot; data-end=&quot;170&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1&amp;nbsp;&lt;strong data-start=&quot;174&quot; data-end=&quot;195&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Management Groups&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; – Organize resources and subscriptions.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;64&quot; data-end=&quot;170&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;2&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;238&quot; data-end=&quot;255&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Subscriptions&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; – Separate environments for different teams or projects.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;64&quot; data-end=&quot;170&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;3&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;315&quot; data-end=&quot;329&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Networking&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; – Configure Virtual Networks (VNets) and connectivity.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;64&quot; data-end=&quot;170&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;387&quot; data-end=&quot;399&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Security&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; – Define user roles and access permissions.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;64&quot; data-end=&quot;170&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;5&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;446&quot; data-end=&quot;458&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Policies&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; – Apply company rules and compliance requirements.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;64&quot; data-end=&quot;170&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;6&amp;nbsp;&lt;/span&gt;&lt;strong data-start=&quot;512&quot; data-end=&quot;526&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Monitoring&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; – Track resource health, activities, and logs.&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;h3 data-section-id=&quot;szd7uh&quot; data-start=&quot;575&quot; data-end=&quot;606&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Very Short Interview Answer&lt;/font&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;szd7uh&quot; data-start=&quot;575&quot; data-end=&quot;606&quot;&gt;&lt;strong data-start=&quot;610&quot; data-end=&quot;770&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Azure Landing Zone works by setting up management groups, subscriptions, networking, security, policies, and monitoring before Azure resources are deployed.&lt;/font&gt;&lt;/strong&gt;&lt;/h3&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="840" width="360" x="2400" y="80" as="geometry" />
        </mxCell>
