        <mxCell id="NBtGaCiOh14KMYiGG-WB-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#cce5ff;strokeColor=#36393d;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;h2 data-section-id=&quot;suozv1&quot; data-start=&quot;274&quot; data-end=&quot;289&quot; style=&quot;text-align: center;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;1. Hierarchy&lt;/font&gt;&lt;/h2&gt;&lt;h3 data-section-id=&quot;d0tz9m&quot; data-start=&quot;290&quot; data-end=&quot;302&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Kya hai?&lt;/font&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;d0tz9m&quot; data-start=&quot;290&quot; data-end=&quot;302&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;Resources ko organize karne ka structure.&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Easy Example -&amp;nbsp;&lt;/font&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;Jaise company mein departments hote hain:&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;HR&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;Finance&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;IT&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px; font-weight: normal;&quot;&gt;Azure mein:&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;Production&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;Development&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-weight: normal;&quot;&gt;Testing&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px;&quot;&gt;Interview Answer&lt;/span&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;346&quot; data-end=&quot;362&quot;&gt;&lt;strong data-start=&quot;499&quot; data-end=&quot;587&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Hierarchy is used to organize Azure resources and subscriptions in a structured way.&lt;/font&gt;&lt;/strong&gt;&lt;/h3&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;" vertex="1">
