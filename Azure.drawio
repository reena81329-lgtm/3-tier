        <mxCell id="a9LHC2ZdMc9pHRIlVeNS-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Is diagram ko ek hi din mein yaad mat karo. Isse &lt;span data-start=&quot;5784&quot; data-end=&quot;5802&quot; style=&quot;&quot;&gt;4 chhote parts&lt;/span&gt; mein padho&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;strong data-start=&quot;5818&quot; data-end=&quot;5829&quot;&gt;Part 1:&lt;/strong&gt; User → Front Door → Application Gateway → WAF&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;strong data-start=&quot;5878&quot; data-end=&quot;5889&quot;&gt;Part 2:&lt;/strong&gt; VNet → Subnet → NSG&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;strong data-start=&quot;5912&quot; data-end=&quot;5923&quot;&gt;Part 3:&lt;/strong&gt; Frontend VM → Load Balancer → Backend VM → Database&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;strong data-start=&quot;5978&quot; data-end=&quot;5989&quot; style=&quot;&quot;&gt;Part 4:&lt;/strong&gt; Firewall → Key Vault → Bastion → Storage&lt;/font&gt;&lt;/div&gt;" vertex="1">
