ain&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1979&quot; data-end=&quot;1985&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ske baad students aate hain.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1979&quot; data-end=&quot;1985&quot;&gt;&lt;b style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Azure mein:&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;1979&quot; data-end=&quot;1985&quot;&gt;&lt;b style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Landing Zone →&lt;/b&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; Pehle setup&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1979&quot; data-end=&quot;1985&quot;&gt;&lt;b style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Phir:&lt;/b&gt;&lt;/p&gt;&lt;p data-start=&quot;1979&quot; data-end=&quot;1985&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;VM banao&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1979&quot; data-end=&quot;1985&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Storage banao&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;1979&quot; data-end=&quot;1985&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Website deploy karo&lt;/span&gt;&lt;/p&gt;" vertex="1">
