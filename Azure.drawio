        <mxCell id="NBtGaCiOh14KMYiGG-WB-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;On Prem&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;On Prem kya hota h -&amp;nbsp;&lt;strong data-start=&quot;0&quot; data-end=&quot;25&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;On-Prem (On-Premises)&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; ka matlab hota hai ki company ke &lt;/span&gt;&lt;strong data-start=&quot;59&quot; data-end=&quot;121&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;apne office ya data center mein servers aur infrastructure&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; rakha hua hai.&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;h3 data-section-id=&quot;1wvv2sg&quot; data-start=&quot;138&quot; data-end=&quot;154&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Easy Example&lt;/font&gt;&lt;/h3&gt;&lt;p data-start=&quot;156&quot; data-end=&quot;204&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Maan lo ek company ke paas apna server room hai.&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;156&quot; data-end=&quot;204&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Servers&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;156&quot; data-end=&quot;204&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Networking devices&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;156&quot; data-end=&quot;204&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Storage&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;156&quot; data-end=&quot;204&quot;&gt;&lt;span style=&quot;font-size: 20px; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Power backup&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;156&quot; data-end=&quot;204&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 20px;&quot;&gt;Sab kuch company khud manage karti hai.&lt;/span&gt;&lt;/p&gt;&lt;p data-start=&quot;304&quot; data-end=&quot;350&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Ye &lt;strong data-start=&quot;307&quot; data-end=&quot;337&quot;&gt;On-Premises Infrastructure&lt;/strong&gt; kehlata hai.&lt;/font&gt;&lt;/p&gt;&lt;h3 data-section-id=&quot;7tfvn8&quot; data-start=&quot;352&quot; data-end=&quot;372&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;On-Prem vs Cloud&lt;/font&gt;&lt;/h3&gt;&lt;p data-start=&quot;156&quot; data-end=&quot;204&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;On-Prem&lt;/span&gt;&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Company ke office/data center mein server&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Company Office&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;│&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;├─ Server&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;├─ Storage&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;└─ Network&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Cloud(Azure/AWS/GCP)&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Server cloud provider ke data center mein hota hai.&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Company&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;│&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Internet&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;│&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Azure Cloud&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;├─ VM&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;├─ Storage&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;&amp;nbsp; &amp;nbsp;└─ Database&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;h3 data-section-id=&quot;7pftqr&quot; data-start=&quot;680&quot; data-end=&quot;700&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Interview Answer&lt;/font&gt;&lt;/h3&gt;&lt;h3 data-section-id=&quot;7pftqr&quot; data-start=&quot;680&quot; data-end=&quot;700&quot;&gt;&lt;strong data-start=&quot;704&quot; data-end=&quot;886&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;On-Premises (On-Prem) means IT infrastructure such as servers, storage, and networking equipment that is hosted and managed within a company&#39;s own data center or office location.&lt;/font&gt;&lt;/strong&gt;&lt;/h3&gt;&lt;div&gt;&lt;strong data-start=&quot;704&quot; data-end=&quot;886&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Hindi&lt;/font&gt;&lt;/strong&gt;&lt;/div&gt;&lt;h3 data-section-id=&quot;7pftqr&quot; data-start=&quot;680&quot; data-end=&quot;700&quot;&gt;&lt;strong data-start=&quot;704&quot; data-end=&quot;886&quot; style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px;&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;On-Premises (On-Prem) ka matlab hai aisa IT infrastructure, jaise servers, storage aur networking equipment, jo company ke apne data center ya office mein host aur manage kiya jata hai.&lt;/font&gt;&lt;/strong&gt;&lt;/h3&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1400" width="440" x="40" y="1040" as="geometry" />
        </mxCell>
